{% macro pintar_estrellas(cantidad, calificacion_fmt) -%}
<span class="estrellas" aria-hidden="true">{% for i in range(5) %}{% if i < cantidad %}★{% else %}☆{% endif %}{% endfor %}</span><span class="sr-only">{{ calificacion_fmt }} de 5 estrellas</span>
{%- endmacro %}
{% macro celda_cambio(cambio) -%}
{%- if cambio.tipo == 'nuevo' -%}
<span class="cambio cambio-nuevo">nuevo</span>
{%- elif cambio.tipo == 'subio' -%}
<span class="cambio cambio-sube"><span aria-hidden="true">▲</span> {{ cambio.valor }}</span>
{%- elif cambio.tipo == 'bajo' -%}
<span class="cambio cambio-baja"><span aria-hidden="true">▼</span> {{ cambio.valor }}</span>
{%- else -%}
<span class="cambio cambio-igual">igual</span>
{%- endif -%}
{%- endmacro %}
{% macro barra_indice(pct) -%}
<div class="barra-indice"><div class="barra-indice-relleno" style="width: {{ pct }}%;"></div></div>
{%- endmacro %}
{% macro barra_distribucion(fila) -%}
<div class="fila-distribucion">
<span class="fila-distribucion-etiqueta">{{ fila.estrellas }}<span aria-hidden="true"> ★</span></span>
<span class="barra-distribucion"><span class="barra-distribucion-relleno" style="width: {{ fila.pct }}%;"></span></span>
<span class="fila-distribucion-valor">{{ fila.cantidad_fmt }} ({{ fila.pct }}%)</span>
</div>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="es-CR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ config.nombre_corto }}</title>
<meta name="description" content="{{ config.descripcion }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ config.nombre_corto }}">
<meta property="og:description" content="{{ config.descripcion }}">
<meta property="og:url" content="{{ config.url_publica }}">
<link rel="canonical" href="{{ config.url_publica }}">
<link rel="preload" href="{{ ruta_fuentes }}Aeonik-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ ruta_fuentes }}TimesNow-Light.woff2" as="font" type="font/woff2" crossorigin>
<script type="application/ld+json">{{ jsonld | tojson }}</script>
<style>
@font-face { font-family: "Aeonik"; src: url("{{ ruta_fuentes }}Aeonik-Regular.woff2") format("woff2"); font-weight: 400 700; font-style: normal; font-display: swap; }
@font-face { font-family: "Times Now"; src: url("{{ ruta_fuentes }}TimesNow-ExtraLight.woff2") format("woff2"); font-weight: 200; font-style: normal; font-display: swap; }
@font-face { font-family: "Times Now"; src: url("{{ ruta_fuentes }}TimesNow-Light.woff2") format("woff2"); font-weight: 300; font-style: normal; font-display: swap; }
@font-face { font-family: "Times Now"; src: url("{{ ruta_fuentes }}TimesNow-LightItalic.woff2") format("woff2"); font-weight: 300; font-style: italic; font-display: swap; }
@font-face { font-family: "Times Now"; src: url("{{ ruta_fuentes }}TimesNow-SemiBold.woff2") format("woff2"); font-weight: 600; font-style: normal; font-display: swap; }
@font-face { font-family: "Times Now"; src: url("{{ ruta_fuentes }}TimesNow-SemiBoldItalic.woff2") format("woff2"); font-weight: 600; font-style: italic; font-display: swap; }
:root {
  color-scheme: light;
  --paper: #fbfbf9;
  --navy: #0b1929;
  --navy-oscuro: #060d16;
  --verde: #6fffd3;
  --verde-tinta: #0f8f6b;
  --muted: #f1f2ee;
  --borde: rgba(11, 25, 41, .12);
  --borde-fuerte: rgba(11, 25, 41, .28);
  --texto: var(--navy);
  --texto-suave: rgba(11, 25, 41, .68);
  --texto-tenue: rgba(11, 25, 41, .56);
  --sube: #0f7a4a;
  --baja: #b3261e;
  --display: "Aeonik", "Helvetica Neue", Arial, sans-serif;
  --cuerpo: "Times Now", Georgia, "Times New Roman", serif;
  --radio: .4rem;
  --ancho: 1180px;
  /* alias que usa el resto de la hoja */
  --color-bg: var(--paper); --color-texto: var(--texto); --color-muted: var(--texto-suave); --color-muted-claro: var(--texto-tenue);
  --color-borde: var(--borde); --color-borde-fuerte: var(--borde-fuerte); --color-acento: var(--navy); --color-acento-suave: var(--muted);
  --color-sube: var(--sube); --color-baja: var(--baja); --fuente-cuerpo: var(--cuerpo); --fuente-titulo: var(--display); --ancho-contenedor: var(--ancho);
}
*, *::before, *::after { box-sizing: border-box; }
html { color-scheme: light; scroll-behavior: smooth; }
body { margin: 0; background: var(--paper); color: var(--texto); font-family: var(--cuerpo); font-weight: 300; font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
h1, h2, h3, h4 { font-family: var(--display); font-weight: 700; line-height: 1.1; margin: 0 0 .6rem; color: var(--texto); letter-spacing: -.02em; }
h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); font-weight: 500; letter-spacing: -.03em; }
h2 { font-size: clamp(1.5rem, 2.6vw, 2.1rem); text-transform: uppercase; margin-top: 0; }
h3 { font-size: 1.15rem; font-weight: 500; letter-spacing: -.01em; }
h4 { font-family: var(--display); font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .16em; color: var(--texto-suave); }
p { margin: 0 0 .85rem; }
ul, ol { margin: 0 0 .85rem; }
a { color: var(--navy); text-decoration: underline; text-decoration-color: rgba(11, 25, 41, .35); text-underline-offset: 3px; }
a:hover { text-decoration-color: var(--navy); }
strong { font-family: var(--display); font-weight: 700; }
[hidden] { display: none !important; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
.skip-link { position: absolute; left: -9999px; top: 0; background: var(--navy); color: #fff; padding: .6rem 1rem; z-index: 20; }
.skip-link:focus { left: 0; }
.contenedor { max-width: var(--ancho); margin: 0 auto; padding: 0 20px; }
button, input, select { font-family: var(--display); font-size: .95rem; }
:focus-visible { outline: 3px solid var(--verde); outline-offset: 2px; }
.eyebrow { font-family: var(--display); font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .18em; margin: 0 0 1rem; }
.num { font-family: var(--display); font-variant-numeric: tabular-nums; }

/* Barra superior, como la del sitio */
.barra { position: sticky; top: 0; z-index: 30; padding: 12px 12px 0; }
.barra-interna { max-width: 1280px; margin: 0 auto; height: 60px; display: flex; align-items: center; justify-content: space-between; padding: 0 18px 0 20px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .16); background: rgba(11, 25, 41, .78); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
.barra-logo img { height: 26px; width: auto; display: block; }
.barra-nav { display: flex; align-items: center; gap: .25rem; }
.barra-nav a { font-family: var(--display); font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; text-decoration: none; padding: .55rem .9rem; border-radius: 999px; color: rgba(255, 255, 255, .8); }
.barra-nav a:hover { color: #fff; background: rgba(255, 255, 255, .08); }
.barra-nav a.cta { background: var(--verde); color: var(--navy); }
.barra-nav a.cta:hover { background: #8dffdd; }

/* Portada oscura */
.portada { background: var(--navy); color: #fff; margin-top: -72px; padding: 150px 0 72px; position: relative; overflow: hidden; }
.portada::after { content: ""; position: absolute; inset: auto -10% -40% auto; width: 60vw; max-width: 720px; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(closest-side, rgba(111, 255, 211, .16), rgba(111, 255, 211, 0)); pointer-events: none; }
.portada .contenedor { position: relative; }
.portada .eyebrow { color: var(--verde); }
.portada h1 { color: #fff; max-width: 15ch; margin-bottom: 1.2rem; }
.portada h1 .acento { color: var(--verde); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 8px; }
.portada .bajada { font-size: clamp(1.15rem, 1.8vw, 1.45rem); line-height: 1.45; max-width: 44ch; color: rgba(255, 255, 255, .86); margin-bottom: 2.4rem; }
.cifras-universo { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; max-width: 720px; padding-top: 1.6rem; border-top: 1px solid rgba(255, 255, 255, .16); }
.cifra { display: flex; flex-direction: column; gap: .3rem; }
.cifra-numero { font-family: var(--display); font-size: clamp(2rem, 3.4vw, 2.8rem); font-weight: 500; letter-spacing: -.03em; line-height: 1; color: #fff; }
.cifra-etiqueta { font-family: var(--display); font-size: .68rem; text-transform: uppercase; letter-spacing: .14em; color: var(--verde); }
.linea-datos { font-family: var(--display); font-size: .78rem; letter-spacing: .02em; color: rgba(255, 255, 255, .62); margin: 1.6rem 0 0; }

/* Franja "sobre este ranking" */
.sobre { background: #fff; border-bottom: 1px solid var(--borde); padding: 3.2rem 0; }
.sobre-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.2rem; }
.sobre-bloque h4 { margin-bottom: .55rem; color: var(--navy); }
.sobre-bloque h4::before { content: ""; display: inline-block; width: 10px; height: 10px; background: var(--verde); border-radius: 50%; margin-right: .6rem; vertical-align: 1px; }
.sobre-bloque p { font-size: 1.02rem; color: var(--texto-suave); margin: 0; max-width: 40ch; }

main { padding: 3.5rem 0 1rem; }
main > .contenedor > section { margin-bottom: 4rem; }
.titulo-seccion { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.4rem; }
.titulo-seccion p { font-family: var(--display); font-size: .72rem; text-transform: uppercase; letter-spacing: .14em; color: var(--texto-suave); margin: 0; }

/* Podio */
.podio-lista { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; }
.podio-tarjeta { background: #fff; border: 1px solid var(--borde); border-radius: var(--radio); padding: 1.6rem 1.4rem 1.3rem; position: relative; }
.podio-tarjeta:first-child { border-color: var(--navy); box-shadow: inset 0 3px 0 var(--verde); }
.podio-posicion { position: absolute; top: 1.2rem; right: 1.2rem; font-family: var(--display); font-weight: 700; font-size: .7rem; letter-spacing: .14em; color: var(--texto-suave); }
.podio-posicion::before { content: "N.º "; }
.podio-nombre { font-size: 1.2rem; margin: .1rem 3.4rem .25rem 0; }
.podio-tipo { font-family: var(--display); font-size: .68rem; color: var(--texto-suave); text-transform: uppercase; letter-spacing: .12em; margin-bottom: .8rem; }
.podio-calificacion { display: flex; align-items: baseline; gap: .5rem; margin: .9rem 0 .1rem; }
.podio-calificacion-num { font-family: var(--display); font-weight: 700; font-size: 1.15rem; }
.podio-resenas { font-size: .95rem; color: var(--texto-suave); margin-bottom: .9rem; }
.podio-indice { font-family: var(--display); font-size: .72rem; text-transform: uppercase; letter-spacing: .14em; color: var(--texto-suave); margin-bottom: 0; }
.podio-indice strong { display: block; font-size: 2rem; font-weight: 500; letter-spacing: -.03em; color: var(--navy); text-transform: none; margin-top: .2rem; }

/* Estrellas */
.estrellas { color: var(--navy); letter-spacing: 1px; font-size: .95rem; }

/* Controles */
.controles { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: flex-end; padding: 1.1rem 0; border-top: 1px solid var(--borde); border-bottom: 1px solid var(--borde); }
.tabs { display: flex; gap: .5rem; flex-wrap: wrap; }
.tab-btn { background: #fff; border: 1px solid var(--borde-fuerte); color: var(--texto); padding: .5rem 1rem; border-radius: 999px; cursor: pointer; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; }
.tab-btn.es-activa { background: var(--navy); border-color: var(--navy); color: #fff; }
.filtros-secundarios { display: flex; flex-wrap: wrap; gap: 1rem; margin-left: auto; }
.campo-filtro { display: flex; flex-direction: column; gap: .3rem; }
.campo-filtro label { font-family: var(--display); font-size: .66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; color: var(--texto-suave); }
.campo-filtro select, .campo-filtro input { padding: .5rem .7rem; border: 1px solid var(--borde-fuerte); border-radius: var(--radio); background: #fff; color: var(--texto); min-width: 13rem; font-family: var(--cuerpo); font-weight: 300; font-size: 1rem; }
.resumen-filtro { font-family: var(--display); font-size: .72rem; letter-spacing: .04em; color: var(--texto-suave); margin: .85rem 0 0; }

/* Tabla */
table.ranking-table { width: 100%; border-collapse: collapse; margin-top: .4rem; background: #fff; border: 1px solid var(--borde); border-radius: var(--radio); overflow: hidden; }
table.ranking-table th, table.ranking-table td { text-align: left; padding: .9rem .7rem; border-bottom: 1px solid var(--borde); vertical-align: top; }
table.ranking-table thead th { font-family: var(--display); font-size: .64rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; color: var(--texto-suave); background: var(--muted); border-bottom: 1px solid var(--borde); white-space: nowrap; }
table.ranking-table th[data-sort-key] { cursor: pointer; user-select: none; }
table.ranking-table th[aria-sort="ascending"]::after { content: " ▲"; }
table.ranking-table th[aria-sort="descending"]::after { content: " ▼"; }
table.ranking-table td { font-family: var(--display); font-size: .95rem; font-variant-numeric: tabular-nums; }
.valor-pos { font-weight: 700; font-size: 1.05rem; }
.hospital-nombre { display: block; font-weight: 700; font-size: 1rem; letter-spacing: -.01em; }
.hospital-tipo { display: block; font-size: .78rem; color: var(--texto-suave); margin-top: .15rem; }
.hospital-grupo { display: block; font-family: var(--display); font-size: .66rem; text-transform: uppercase; letter-spacing: .1em; color: var(--verde-tinta); margin-top: .25rem; }
.hospital-ubicacion { display: block; font-family: var(--cuerpo); font-weight: 300; font-size: .92rem; color: var(--texto-tenue); margin-top: .1rem; }
.calificacion-num { font-weight: 700; margin-left: .3rem; }
.delta-chico { display: block; font-size: .72rem; color: var(--texto-suave); margin-top: .15rem; }
.col-indice strong { font-family: var(--display); font-size: 1.15rem; font-weight: 700; }
.barra-indice { background: var(--muted); border-radius: 3px; height: 6px; margin-top: .4rem; width: 100%; max-width: 120px; overflow: hidden; }
.barra-indice-relleno { background: linear-gradient(90deg, var(--navy), #1d3f66); height: 100%; }
.btn-detalle { background: #fff; border: 1px solid var(--borde-fuerte); border-radius: 999px; padding: .4rem .85rem; font-size: .66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; cursor: pointer; color: var(--navy); white-space: nowrap; }
.btn-detalle:hover { background: var(--navy); color: #fff; border-color: var(--navy); }
.cambio { font-size: .8rem; font-weight: 700; white-space: nowrap; }
.cambio-sube { color: var(--sube); }
.cambio-baja { color: var(--baja); }
.cambio-igual { color: var(--texto-tenue); font-weight: 400; }
.cambio-nuevo { color: var(--texto-suave); font-weight: 700; text-transform: uppercase; font-size: .62rem; letter-spacing: .12em; }

/* Detalle expandible */
tr.row-detalle td { background: var(--paper); border-bottom: 1px solid var(--borde); font-family: var(--cuerpo); font-weight: 300; font-size: 1rem; }
.detalle-contenido { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.6rem; padding: .5rem 0; }
.detalle-bloque h4 { margin-bottom: .6rem; }
.detalle-nota { font-size: .95rem; color: var(--texto-suave); font-style: italic; }
.fila-distribucion { display: flex; align-items: center; gap: .5rem; margin-bottom: .35rem; font-family: var(--display); font-size: .78rem; }
.fila-distribucion-etiqueta { width: 1.8rem; flex-shrink: 0; }
.barra-distribucion { flex: 1; background: var(--muted); border-radius: 3px; height: 8px; display: block; overflow: hidden; }
.barra-distribucion-relleno { display: block; background: var(--verde); height: 100%; }
.fila-distribucion-valor { width: 7rem; flex-shrink: 0; color: var(--texto-suave); text-align: right; font-variant-numeric: tabular-nums; }
.detalle-cifras dl { margin: 0; }
.detalle-cifras dl > div { display: flex; justify-content: space-between; gap: .5rem; border-bottom: 1px dotted var(--borde-fuerte); padding: .3rem 0; font-size: .95rem; }
.detalle-cifras dt { color: var(--texto-suave); }
.detalle-cifras dd { margin: 0; font-family: var(--display); font-weight: 700; font-variant-numeric: tabular-nums; }
.detalle-enlaces { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: .5rem; }
.tendencias-fila { display: flex; gap: 1.5rem; flex-wrap: wrap; }
.tendencia { display: flex; flex-direction: column; gap: .3rem; }
.tendencia-etiqueta { font-family: var(--display); font-size: .68rem; text-transform: uppercase; letter-spacing: .12em; color: var(--texto-suave); }
.sparkline { display: block; }

/* Fuera del ranking */
.fuera-ranking ul { list-style: none; padding: 0; margin: 0; }
.fuera-ranking li { padding: .6rem 0; border-bottom: 1px dotted var(--borde-fuerte); font-size: 1rem; color: var(--texto-suave); }
.fuera-ranking li strong { color: var(--texto); }

/* Qué cambió */
.cambio-columnas { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
.cambio-columnas h3 { font-size: .72rem; text-transform: uppercase; letter-spacing: .14em; font-weight: 700; color: var(--texto-suave); }
.cambio-columnas ul { list-style: none; margin: 0; padding: 0; }
.cambio-columnas li { padding: .45rem 0; border-bottom: 1px dotted var(--borde-fuerte); font-size: 1rem; }
.cambio-columnas .cambio-valor-sube { color: var(--sube); font-family: var(--display); font-weight: 700; }
.cambio-columnas .cambio-valor-baja { color: var(--baja); font-family: var(--display); font-weight: 700; }

/* Metodología */
.metodologia { background: #fff; border: 1px solid var(--borde); border-radius: var(--radio); padding: 2.2rem 2rem; }
.metodologia p { max-width: 70ch; font-size: 1.05rem; }
.metodologia ul { padding-left: 1.2rem; max-width: 70ch; }
.metodologia strong { font-family: var(--display); font-weight: 700; }

/* Datos abiertos */
.datos-abiertos ul { padding-left: 1.1rem; }
.datos-abiertos li { margin-bottom: .3rem; }

/* Pie oscuro, como el del sitio */
.pie { background: var(--navy-oscuro); color: rgba(255, 255, 255, .78); padding: 3rem 0 2.6rem; margin-top: 2rem; }
.pie .contenedor { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; align-items: start; }
.pie img { height: 28px; width: auto; display: block; margin-bottom: 1rem; }
.pie p { margin: 0 0 .4rem; font-size: .98rem; }
.pie a { color: #fff; text-decoration-color: rgba(255, 255, 255, .4); }
.pie .pie-meta { font-family: var(--display); font-size: .68rem; text-transform: uppercase; letter-spacing: .14em; color: rgba(255, 255, 255, .55); margin-top: 1.2rem; }
.pie .pie-nav { display: flex; flex-direction: column; gap: .4rem; font-family: var(--display); font-size: .72rem; text-transform: uppercase; letter-spacing: .14em; }
.pie .pie-nav a { text-decoration: none; color: rgba(255, 255, 255, .78); }
.pie .pie-nav a:hover { color: var(--verde); }

/* Móvil: tabla a tarjetas apiladas, sin scroll horizontal */
@media (max-width: 860px) {
  .sobre-grid { grid-template-columns: 1fr; gap: 1.4rem; }
  .pie .contenedor { grid-template-columns: 1fr; }
}
@media (max-width: 720px) {
  body { font-size: 16px; }
  .barra { padding: 10px 10px 0; }
  .barra-interna { height: 54px; padding: 0 12px 0 16px; }
  .barra-nav a { padding: .45rem .6rem; font-size: .62rem; }
  .barra-nav a.secundario { display: none; }
  .portada { margin-top: -64px; padding: 120px 0 56px; }
  .cifras-universo { grid-template-columns: 1fr 1fr; }
  .podio-lista { grid-template-columns: 1fr; }
  .filtros-secundarios { margin-left: 0; width: 100%; }
  .campo-filtro { width: 100%; }
  .campo-filtro select, .campo-filtro input { min-width: 0; width: 100%; }
  .cambio-columnas { grid-template-columns: 1fr; gap: 1rem; }
  .metodologia { padding: 1.5rem 1.1rem; }

  table.ranking-table { border: none; background: transparent; }
  table.ranking-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; padding: 0; margin: -1px; }
  table.ranking-table, table.ranking-table tbody, table.ranking-table tr, table.ranking-table td { display: block; width: 100%; }
  table.ranking-table tr.row-main { background: #fff; border: 1px solid var(--borde); border-radius: var(--radio); padding: .9rem; margin-bottom: .8rem; }
  table.ranking-table tr.row-detalle { border: none; }
  table.ranking-table tr.row-detalle td { border: 1px solid var(--borde); border-top: none; border-radius: 0 0 var(--radio) var(--radio); margin: -.8rem 0 .8rem; }
  table.ranking-table td { border-bottom: none; padding: .35rem 0; }
  table.ranking-table td[data-label]::before { content: attr(data-label); display: block; font-size: .6rem; text-transform: uppercase; letter-spacing: .14em; color: var(--texto-tenue); margin-bottom: .1rem; }
  .barra-indice { max-width: none; }
}

@media print {
  .barra, .controles, .resumen-filtro, .btn-detalle, .col-detalle, .skip-link { display: none !important; }
  .portada { background: #fff; color: #000; margin-top: 0; padding: 1rem 0; }
  .portada h1, .cifra-numero { color: #000; }
  a { color: #000; text-decoration: none; }
  .podio-tarjeta { break-inside: avoid; }
}
</style>
</head>
<body>
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<div class="barra">
  <div class="barra-interna">
    <a class="barra-logo" href="https://flowresults.com/" aria-label="Flow Results, inicio"><img src="{{ logo_blanco }}" alt="Flow Results" width="1920" height="696"></a>
    <nav class="barra-nav" aria-label="Navegación">
      <a class="secundario" href="https://flowresults.com/ranking">Ranking</a>
      <a class="secundario" href="https://flowresults.com/casos">Casos</a>
      <a class="cta" href="https://flowresults.com/diagnostico">Diagnóstico IA gratis</a>
    </nav>
  </div>
</div>
<header class="portada">
  <div class="contenedor">
{%- set solo_privados = (universo.publicos or 0) == 0 %}
    <p class="eyebrow">{{ 'Hospitales privados de Costa Rica' if solo_privados else 'Hospitales de Costa Rica' }} · {{ etiqueta_periodo }}</p>
    <h1>{{ config.nombre_sitio }}<br><span class="acento">{{ 'Hospitales privados' if solo_privados else 'Hospitales' }} de Costa Rica</span></h1>
    <p class="bajada">Ordenados por lo que dicen sus pacientes en Google: calificación, volumen de reseñas y distribución por estrellas, con un método publicado que cualquiera puede verificar.</p>
    <div class="cifras-universo">
{%- if solo_privados %}
      <div class="cifra"><span class="cifra-numero">{{ universo.total | fmt_num }}</span><span class="cifra-etiqueta">Hospitales privados evaluados</span></div>
      <div class="cifra"><span class="cifra-numero">{{ (universo.total - (universo.sin_datos or 0)) | fmt_num }}</span><span class="cifra-etiqueta">En el ranking</span></div>
      <div class="cifra"><span class="cifra-numero">{{ (universo.sin_datos or 0) | fmt_num }}</span><span class="cifra-etiqueta">Sin datos suficientes</span></div>
{%- else %}
      <div class="cifra"><span class="cifra-numero">{{ universo.total | fmt_num }}</span><span class="cifra-etiqueta">Hospitales evaluados</span></div>
      <div class="cifra"><span class="cifra-numero">{{ universo.publicos | fmt_num }}</span><span class="cifra-etiqueta">Públicos</span></div>
      <div class="cifra"><span class="cifra-numero">{{ universo.privados | fmt_num }}</span><span class="cifra-etiqueta">Privados</span></div>
{%- endif %}
    </div>
    <p class="linea-datos">Datos capturados el {{ capturado_fmt }} · Próxima edición: {{ proxima_fmt }} · Fuente: {{ fuente }}</p>
  </div>
</header>

<section class="sobre" aria-label="Sobre este ranking">
  <div class="contenedor">
    <div class="sobre-grid">
      <div class="sobre-bloque">
        <h4>Datos públicos y verificables</h4>
        <p>Cada cifra sale del perfil público de Google de cada hospital, el mismo que ve cualquier paciente. En cada fila hay un enlace a la ficha original para comprobarla.</p>
      </div>
      <div class="sobre-bloque">
        <h4>Método publicado</h4>
        <p>La fórmula del índice está explicada al pie de esta página y los datos de cada edición se pueden descargar en JSON y CSV. No hay criterios ocultos ni opiniones editoriales.</p>
      </div>
      <div class="sobre-bloque">
        <h4>Se actualiza el {{ config.dia_actualizacion }} de cada mes</h4>
        <p>Cada edición se guarda como historial: el ranking muestra quién sube y quién baja de un mes al siguiente. Próxima edición: {{ proxima_fmt }}.</p>
      </div>
    </div>
  </div>
</section>

<main id="contenido">
  <div class="contenedor">

    <section class="podio" aria-labelledby="titulo-podio">
      <h2 id="titulo-podio">Los tres primeros</h2>
      <ol class="podio-lista">
        {% for h in podio %}
        <li class="podio-tarjeta">
          <span class="podio-posicion">{{ h.posicion }}</span>
          <h3 class="podio-nombre">{{ h.nombre_google }}</h3>
{%- if not solo_privados %}
          <p class="podio-tipo">{{ h.tipo_label }}</p>
{%- endif %}
          <p class="podio-calificacion">{{ pintar_estrellas(h.estrellas, h.calificacion_fmt) }}<span class="podio-calificacion-num">{{ h.calificacion_fmt }}</span></p>
          <p class="podio-resenas">{{ h.resenas_fmt }} reseñas</p>
          <p class="podio-indice">Índice <strong>{{ h.indice_fmt }}</strong></p>
        </li>
        {% endfor %}
      </ol>
    </section>

    <section class="tabla-ranking" aria-labelledby="titulo-tabla">
      <h2 id="titulo-tabla">Ranking completo</h2>

      <div class="controles" aria-label="Controles de la tabla">
{%- if not solo_privados %}
        <div class="tabs" role="group" aria-label="Filtrar por tipo de hospital">
          <button type="button" class="tab-btn es-activa" data-tab="todos" aria-pressed="true">Todos</button>
          <button type="button" class="tab-btn" data-tab="privado" aria-pressed="false">Privados</button>
          <button type="button" class="tab-btn" data-tab="publico" aria-pressed="false">Públicos (CCSS e INS)</button>
        </div>
{%- endif %}
        <div class="filtros-secundarios">
          <div class="campo-filtro">
            <label for="filtro-provincia">Provincia</label>
            <select id="filtro-provincia">
              <option value="">Todas las provincias</option>
              {% for p in provincias %}<option value="{{ p }}">{{ p }}</option>{% endfor %}
            </select>
          </div>
          <div class="campo-filtro">
            <label for="buscador-nombre">Buscar hospital</label>
            <input type="search" id="buscador-nombre" placeholder="Nombre del hospital" autocomplete="off">
          </div>
        </div>
      </div>
      <p class="resumen-filtro" id="resumen-filtro" aria-live="polite"></p>

      <table class="ranking-table">
        <caption class="sr-only">Ranking de hospitales de Costa Rica por reputación en Google: posición, calificación, reseñas e índice.</caption>
        <thead>
          <tr>
            <th scope="col">Posición</th>
            <th scope="col">Cambio</th>
            <th scope="col">Hospital</th>
            <th scope="col" data-sort-key="calificacion" aria-sort="none">Calificación</th>
            <th scope="col" data-sort-key="resenas" aria-sort="none">Reseñas</th>
            <th scope="col" data-sort-key="pct5" aria-sort="none">% 5 estrellas</th>
            <th scope="col" data-sort-key="pct1" aria-sort="none">% 1 estrella</th>
            <th scope="col" data-sort-key="indice" aria-sort="none">Índice</th>
            <th scope="col"><span class="sr-only">Detalle</span></th>
          </tr>
        </thead>
        <tbody>
          {% for h in hospitales %}
          <tr class="row-main"
              data-tipo="{{ h.tipo }}"
              data-provincia="{{ h.provincia }}"
              data-nombre="{{ h.nombre_google | lower }}"
              data-pos-todos="{{ h.posicion if h.posicion is not none else '' }}"
              data-pos-tipo="{{ h.posicion_tipo if h.posicion_tipo is not none else '' }}"
              data-calificacion="{{ h.calificacion if h.calificacion is not none else '' }}"
              data-resenas="{{ h.resenas if h.resenas is not none else '' }}"
              data-pct5="{{ h.pct_5 if h.pct_5 is not none else '' }}"
              data-pct1="{{ h.pct_1 if h.pct_1 is not none else '' }}"
              data-indice="{{ h.indice if h.indice is not none else '' }}">
            <td class="col-posicion" data-label="Posición"><span class="valor-pos">{{ h.posicion if h.posicion is not none else 'N/D' }}</span></td>
            <td class="col-cambio" data-label="Cambio">{{ celda_cambio(h.cambio) }}</td>
            <td class="col-hospital" data-label="Hospital">
              <span class="hospital-nombre">{{ h.nombre_google }}</span>
{%- if not solo_privados %}
              <span class="hospital-tipo">{{ h.tipo_label }}</span>
{%- endif %}
{%- if h.grupo %}
              <span class="hospital-grupo">Red {{ h.grupo }}</span>
{%- endif %}
              <span class="hospital-ubicacion">{{ h.provincia }}, {{ h.canton }}</span>
            </td>
            <td class="col-calificacion" data-label="Calificación">{{ pintar_estrellas(h.estrellas, h.calificacion_fmt) }}<span class="calificacion-num">{{ h.calificacion_fmt }}</span></td>
            <td class="col-resenas" data-label="Reseñas">{{ h.resenas_fmt }}{% if h.delta_resenas_fmt %}<span class="delta-chico">{{ h.delta_resenas_fmt }}</span>{% endif %}</td>
            <td class="col-pct5" data-label="% 5 estrellas">{{ h.pct_5_fmt ~ "%" if h.pct_5 is not none else "N/D" }}</td>
            <td class="col-pct1" data-label="% 1 estrella">{{ h.pct_1_fmt ~ "%" if h.pct_1 is not none else "N/D" }}</td>
            <td class="col-indice" data-label="Índice"><strong>{{ h.indice_fmt }}</strong>{{ barra_indice(h.indice_bar_pct) }}</td>
            <td class="col-detalle">
              <button type="button" class="btn-detalle" aria-expanded="false" aria-controls="detalle-{{ h.id }}">Ver detalle</button>
            </td>
          </tr>
          <tr class="row-detalle" id="detalle-{{ h.id }}" data-abierta="0" hidden>
            <td colspan="9">
              <div class="detalle-contenido">
                {% if h.distribucion %}
                <div class="detalle-bloque">
                  <h4>Distribución de reseñas</h4>
                  {% for fila in h.distribucion %}{{ barra_distribucion(fila) }}{% endfor %}
                </div>
                {% else %}
                <div class="detalle-bloque"><p class="detalle-nota">Distribución por estrellas no disponible este mes.</p></div>
                {% endif %}

                <div class="detalle-bloque detalle-cifras">
                  <h4>Cómo se calculó el índice</h4>
                  <dl>
                    <div><dt>Calificación ajustada</dt><dd>{{ h.calificacion_ajustada_fmt }}</dd></div>
                    <div><dt>Puntaje de calificación</dt><dd>{{ h.puntaje_calificacion_fmt }}</dd></div>
                    <div><dt>Puntaje de volumen</dt><dd>{{ h.puntaje_volumen_fmt }}</dd></div>
                  </dl>
                </div>

                <div class="detalle-bloque">
                  <h4>Contacto</h4>
                  {% if h.direccion or h.telefono %}
                  <p>{% if h.direccion %}{{ h.direccion }}<br>{% endif %}{% if h.telefono %}{{ h.telefono }}{% endif %}</p>
                  {% endif %}
                  {% if h.sitio_web or h.maps_url %}
                  <p class="detalle-enlaces">
                    {% if h.sitio_web %}<a href="{{ h.sitio_web }}">Sitio web</a>{% endif %}
                    {% if h.maps_url %}<a href="{{ h.maps_url }}">Ver en Google Maps</a>{% endif %}
                  </p>
                  {% endif %}
                  {% if h.nota_respuesta %}<p class="detalle-nota">{{ h.nota_respuesta }}</p>{% endif %}
                </div>

                {% if h.tendencias %}
                <div class="detalle-bloque detalle-tendencias">
                  <h4>Tendencia ({{ h.tendencias.desde }} a {{ h.tendencias.hasta }})</h4>
                  <div class="tendencias-fila">
                    {% if h.tendencias.indice_svg %}<div class="tendencia"><span class="tendencia-etiqueta">Índice</span>{{ h.tendencias.indice_svg }}</div>{% endif %}
                    {% if h.tendencias.posicion_svg %}<div class="tendencia"><span class="tendencia-etiqueta">Puesto</span>{{ h.tendencias.posicion_svg }}</div>{% endif %}
                  </div>
                </div>
                {% endif %}
              </div>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>

    {% if fuera %}
    <section class="fuera-ranking" aria-labelledby="titulo-fuera">
      <h2 id="titulo-fuera">Fuera del ranking</h2>
      <ul>
        {% for h in fuera %}
        <li><strong>{{ h.nombre_google }}</strong>{% if not solo_privados %} ({{ h.tipo_label }}){% endif %}: {{ h.motivo_exclusion }}{% if h.ultima_posicion %} {{ h.ultima_posicion }}{% endif %}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <section class="que-cambio" aria-labelledby="titulo-cambio">
      <h2 id="titulo-cambio">Qué cambió este mes</h2>
      {% if primera_edicion %}
      <p>Esta es la primera edición del ranking. Los cambios de posición van a aparecer a partir de la siguiente actualización.</p>
      {% else %}
      <div class="cambio-columnas">
        <div>
          <h3>Suben</h3>
          {% if subidas %}
          <ul>
            {% for h in subidas %}<li>{{ h.nombre_google }}: <span class="cambio-valor-sube">sube {{ h.cambio.valor }} puesto{{ 's' if h.cambio.valor != 1 else '' }}</span></li>{% endfor %}
          </ul>
          {% else %}
          <p class="detalle-nota">Sin subidas este mes.</p>
          {% endif %}
        </div>
        <div>
          <h3>Bajan</h3>
          {% if bajadas %}
          <ul>
            {% for h in bajadas %}<li>{{ h.nombre_google }}: <span class="cambio-valor-baja">baja {{ h.cambio.valor }} puesto{{ 's' if h.cambio.valor != 1 else '' }}</span></li>{% endfor %}
          </ul>
          {% else %}
          <p class="detalle-nota">Sin bajadas este mes.</p>
          {% endif %}
        </div>
      </div>
      {% endif %}
    </section>

    <section class="metodologia" aria-labelledby="titulo-metodologia">
      <h2 id="titulo-metodologia">Metodología</h2>
      <p>Cada mes leemos el perfil público de Google (Google Business Profile) de cada hospital: calificación promedio, número total de reseñas y distribución por estrellas.</p>
      <p><strong>Calificación ajustada.</strong> La calificación promedio se ajusta por la cantidad de reseñas con un promedio bayesiano: un hospital con pocas reseñas se acerca al promedio nacional hasta que acumula evidencia. La fórmula es ajustada = (n / (n + m)) × calificación + (m / (n + m)) × C, donde n es el número de reseñas del hospital, m es la mediana de reseñas del universo (este mes: {{ meta.m_fmt }}) y C es el promedio nacional ponderado (este mes: {{ meta.C_fmt }}).</p>
      <p><strong>Volumen de voz.</strong> Cuántas personas han opinado, en escala logarítmica respecto al hospital con más reseñas.</p>
      <p><strong>Índice de reputación (0 a 100)</strong> = {{ meta.peso_calificacion }}% calificación ajustada, llevada a escala de 0 a 100, más {{ meta.peso_volumen }}% volumen de voz.</p>
      <p>Para entrar al ranking un hospital necesita al menos {{ meta.minimo_resenas_fmt }} reseñas.</p>
      <p>El porcentaje de reseñas de 5 estrellas, el de 1 estrella y si el hospital responde reseñas se muestran como señales complementarias. No forman parte del índice.</p>
      <p><strong>Límites.</strong> Las reseñas de Google son opiniones voluntarias de pacientes y acompañantes; miden reputación percibida, no calidad clínica. {% if solo_privados %}Esta edición cubre únicamente hospitales privados; los hospitales públicos de la CCSS y del INS quedan fuera del alcance publicado.{% else %}Los hospitales públicos y privados atienden poblaciones y volúmenes distintos, por eso también se pueden ver por separado.{% endif %}</p>
      <p>Los nombres son los que muestra Google en el perfil de cada hospital.</p>
    </section>

    <section class="datos-abiertos" aria-labelledby="titulo-datos">
      <h2 id="titulo-datos">Datos abiertos</h2>
      <p>Puede descargar los datos de esta edición:</p>
      <ul>
        <li><a href="{{ json_url }}">Ranking completo en JSON</a></li>
        <li><a href="{{ csv_url }}">Ranking completo en CSV</a></li>
        <li><a href="{{ historial_url }}">Historial de ediciones en JSON</a></li>
      </ul>
    </section>

  </div>
</main>

<footer class="pie">
  <div class="contenedor">
    <div>
      <img src="{{ logo_blanco }}" alt="Flow Results" width="1920" height="696">
      <p>Elaborado por <a href="{{ config.editor_url }}">{{ config.editor }}</a> con datos públicos de Google Business Profile. Contacto: <a href="mailto:{{ config.contacto }}">{{ config.contacto }}</a>.</p>
      <p>Se actualiza el {{ config.dia_actualizacion }} de cada mes. Generado el {{ generado_fmt }}.</p>
      <p class="pie-meta">© {{ generado_fmt[-4:] }} Flow Results · AI Native Clinic Growth Studio</p>
    </div>
    <nav class="pie-nav" aria-label="Enlaces de Flow">
      <a href="https://flowresults.com/">flowresults.com</a>
      <a href="https://flowresults.com/ranking">Ranking de visibilidad</a>
      <a href="https://flowresults.com/casos">Casos</a>
      <a href="https://flowresults.com/diagnostico">Diagnóstico IA gratis</a>
      <a href="#titulo-metodologia">Metodología</a>
      <a href="#titulo-datos">Datos abiertos</a>
    </nav>
  </div>
</footer>

<script>
function iniciarRanking() {
  "use strict";
  var tabla = document.querySelector(".ranking-table");
  if (!tabla) { return; }
  var cuerpo = tabla.querySelector("tbody");
  function sinTildes(t) { var texto = t ? String(t) : ""; return texto.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase(); }
  var botonesTab = Array.prototype.slice.call(document.querySelectorAll(".tab-btn"));
  var selectorProvincia = document.getElementById("filtro-provincia");
  var buscador = document.getElementById("buscador-nombre");
  var resumen = document.getElementById("resumen-filtro");

  var estado = { tab: "todos", provincia: "", texto: "" };

  function filasPrincipales() {
    return Array.prototype.slice.call(cuerpo.querySelectorAll("tr.row-main"));
  }

  function detalleDe(fila) {
    var siguiente = fila.nextElementSibling;
    if (siguiente && siguiente.classList.contains("row-detalle")) { return siguiente; }
    return null;
  }

  function aplicarFiltros() {
    var total = 0;
    var visibles = 0;
    filasPrincipales().forEach(function (fila) {
      total += 1;
      var coincideTipo = estado.tab === "todos" ? true : fila.dataset.tipo === estado.tab;
      var coincideProvincia = estado.provincia === "" ? true : fila.dataset.provincia === estado.provincia;
      var coincideTexto = estado.texto === "" ? true : sinTildes(fila.dataset.nombre).indexOf(estado.texto) !== -1;
      var visible = coincideTipo && coincideProvincia && coincideTexto;
      fila.hidden = !visible;
      var detalle = detalleDe(fila);
      if (detalle) {
        if (!visible) {
          detalle.hidden = true;
        } else {
          detalle.hidden = detalle.dataset.abierta !== "1";
        }
      }
      if (visible) { visibles += 1; }
      var celdaPos = fila.querySelector(".valor-pos");
      if (celdaPos) {
        celdaPos.textContent = estado.tab === "todos" ? fila.dataset.posTodos : fila.dataset.posTipo;
      }
    });
    if (resumen) {
      resumen.textContent = "Mostrando " + visibles + " de " + total + " hospitales.";
    }
  }

  botonesTab.forEach(function (boton) {
    boton.addEventListener("click", function () {
      botonesTab.forEach(function (b) {
        b.classList.remove("es-activa");
        b.setAttribute("aria-pressed", "false");
      });
      boton.classList.add("es-activa");
      boton.setAttribute("aria-pressed", "true");
      estado.tab = boton.dataset.tab;
      aplicarFiltros();
    });
  });

  if (selectorProvincia) {
    selectorProvincia.addEventListener("change", function () {
      estado.provincia = selectorProvincia.value;
      aplicarFiltros();
    });
  }

  if (buscador) {
    buscador.addEventListener("input", function () {
      estado.texto = sinTildes(buscador.value.trim());
      aplicarFiltros();
    });
  }

  var encabezadosOrdenables = Array.prototype.slice.call(tabla.querySelectorAll("th[data-sort-key]"));
  var ordenActual = { llave: null, direccion: "desc" };

  function ordenarPor(th) {
    var llave = th.dataset.sortKey;
    var direccion = "desc";
    if (ordenActual.llave === llave && ordenActual.direccion === "desc") {
      direccion = "asc";
    }
    ordenActual = { llave: llave, direccion: direccion };

    encabezadosOrdenables.forEach(function (otro) { otro.setAttribute("aria-sort", "none"); });
    th.setAttribute("aria-sort", direccion === "asc" ? "ascending" : "descending");

    var items = filasPrincipales().map(function (fila) {
      var crudo = fila.dataset[llave];
      var valor = crudo === "" ? null : parseFloat(crudo);
      return { fila: fila, detalle: detalleDe(fila), valor: valor };
    });

    function comparable(valor) {
      if (valor === null) { return -Infinity; }
      if (isNaN(valor)) { return -Infinity; }
      return valor;
    }

    items.sort(function (a, b) {
      var av = comparable(a.valor);
      var bv = comparable(b.valor);
      if (av === bv) { return 0; }
      var mayor = av > bv;
      if (direccion === "asc") { return mayor ? 1 : -1; }
      return mayor ? -1 : 1;
    });

    items.forEach(function (item) {
      cuerpo.appendChild(item.fila);
      if (item.detalle) { cuerpo.appendChild(item.detalle); }
    });
  }

  encabezadosOrdenables.forEach(function (th) {
    th.setAttribute("tabindex", "0");
    th.setAttribute("role", "button");
    th.addEventListener("click", function () { ordenarPor(th); });
    th.addEventListener("keydown", function (evento) {
      var tecla = evento.key;
      var esActivacion = tecla === "Enter" ? true : tecla === " ";
      if (esActivacion) {
        evento.preventDefault();
        ordenarPor(th);
      }
    });
  });

  Array.prototype.slice.call(tabla.querySelectorAll(".btn-detalle")).forEach(function (boton) {
    boton.addEventListener("click", function () {
      var fila = boton.closest("tr");
      var detalle = detalleDe(fila);
      if (!detalle) { return; }
      var estabaAbierta = detalle.dataset.abierta === "1";
      detalle.dataset.abierta = estabaAbierta ? "0" : "1";
      detalle.hidden = estabaAbierta;
      boton.setAttribute("aria-expanded", estabaAbierta ? "false" : "true");
      boton.textContent = estabaAbierta ? "Ver detalle" : "Ocultar detalle";
    });
  });

  aplicarFiltros();
}
iniciarRanking();
</script>
{%- if url_actualizacion %}
<script>
(function () {
  "use strict";
  var periodoLocal = {{ periodo | tojson }};
  var base = {{ url_actualizacion | tojson }};
  if (!window.fetch || !window.DOMParser) { return; }
  fetch(base + "data/latest.json", { cache: "no-store" }).then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
    if (!d || !d.periodo || d.periodo <= periodoLocal) { return; }
    return fetch(base, { cache: "no-store" }).then(function (r) { return r.ok ? r.text() : null; }).then(function (html) {
      if (!html) { return; }
      var doc = new DOMParser().parseFromString(html, "text/html");
      var partes = [".portada", ".sobre", "main"];
      for (var i = 0; i < partes.length; i++) {
        var nuevo = doc.querySelector(partes[i]);
        var actual = document.querySelector(partes[i]);
        if (nuevo && actual) { actual.innerHTML = nuevo.innerHTML; }
      }
      iniciarRanking();
    });
  }).catch(function () { /* sin red: se mantiene la edición embebida */ });
})();
</script>
{%- endif %}
</body>
</html>
